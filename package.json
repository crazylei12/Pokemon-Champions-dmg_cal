{
  "name": "pokemon-champions-assistant",
  "version": "1.1.6",
  "androidVersionCode": 11,
  "description": "Unofficial, local-only Android battle assistant for Pokemon Champions.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "check": "tsc --noEmit && node tools/android/check-app-version.mjs",
    "version:set": "node tools/android/set-app-version.mjs",
    "check:licenses": "node tools/check-third-party-licenses.mjs",
    "harmonyos:phase0:check": "node --test tools/harmonyos/phase0-contracts.test.mjs",
    "harmonyos:assets": "node tools/harmonyos/package-app-assets.mjs",
    "harmonyos:phase2:check": "node --test tools/harmonyos/phase2-scaffold.test.mjs",
    "harmonyos:phase3:check": "node --test tools/harmonyos/phase3-domain.test.mjs",
    "harmonyos:phase4:check": "node --test tools/harmonyos/phase4-storage.test.mjs",
    "harmonyos:phase5:check": "node --test tools/harmonyos/phase5-main-ui.test.mjs",
    "harmonyos:phase6:check": "node --test tools/harmonyos/phase6-own-team-ocr.test.mjs",
    "harmonyos:phase7:check": "node --test tools/harmonyos/phase7-team-preview.test.mjs",
    "harmonyos:phase8:check": "node --test tools/harmonyos/phase8-battle-overlay.test.mjs",
    "harmonyos:phase9:check": "node --test tools/harmonyos/phase9-replay-recording.test.mjs",
    "harmonyos:native-lifecycle:check": "node --test tools/harmonyos/replay-native-lifecycle.test.mjs",
    "harmonyos:preview-native:check": "node --test tools/harmonyos/preview-native-execution.test.mjs",
    "harmonyos:phase10:check": "node --test tools/harmonyos/phase10-final-acceptance.test.mjs",
    "harmonyos:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/check-app-environment.ps1",
    "harmonyos:assemble": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/build-app.ps1 -Variant all -Clean",
    "harmonyos:assemble-release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/build-app.ps1 -Variant all -BuildMode release -Clean",
    "harmonyos:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-app-packages.ps1",
    "harmonyos:verify-release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-app-packages.ps1 -BuildMode release -Variant all",
    "harmonyos:emulator:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-emulator-shell.ps1",
    "harmonyos:phase3:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage3-runtime.ps1",
    "harmonyos:phase4:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage4-storage.ps1",
    "harmonyos:phase5:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage5-main-ui.ps1",
    "harmonyos:phase6:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage6-own-team-ui.ps1",
    "harmonyos:phase7:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage7-team-preview-ui.ps1",
    "harmonyos:phase8:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage8-battle-overlay-ui.ps1",
    "harmonyos:phase9:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage9-replay-ui.ps1",
    "harmonyos:phase10:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/harmonyos/verify-stage10-final.ps1",
    "test": "npm run check && npm run android:test-engine && npm run check:licenses",
    "android:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/bootstrap-android.ps1 -AcceptSdkLicenses",
    "android:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/check-android-env.ps1",
    "android:assets": "node tools/android/build-damage-engine.mjs && node tools/android/export-champions-presets.mjs",
    "android:test-engine": "npm run android:assets && node --test tools/android/damage-engine-regression.test.mjs tools/android/battle-overlay-regression.test.mjs",
    "android:assemble": "npm run check:licenses && npm run android:assets && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/run-gradle.ps1 :app:clean :app:assembleDebug && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/check-apk-release.ps1 -ApkPath android-app/app/build/outputs/apk/debug/app-arm64-v8a-debug.apk -ExpectedAbi arm64-v8a && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/check-apk-release.ps1 -ApkPath android-app/app/build/outputs/apk/debug/app-x86_64-debug.apk -ExpectedAbi x86_64",
    "android:assemble-release": "npm run check:licenses && npm run android:assets && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/run-gradle.ps1 :app:clean :app:testDebugUnitTest :app:lintRelease :app:assembleRelease && npm run android:verify-release",
    "android:assemble-release-arm64": "npm run check:licenses && npm run android:assets && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/run-gradle.ps1 :app:clean :app:testDebugUnitTest :app:lintRelease :app:assembleRelease -PandroidAbis=arm64-v8a && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/check-apk-release.ps1 -ApkPath android-app/app/build/outputs/apk/release/app-arm64-v8a-release.apk -ExpectedAbi arm64-v8a",
    "android:verify-release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/check-apk-release.ps1 -ApkPath android-app/app/build/outputs/apk/release/app-arm64-v8a-release.apk -ExpectedAbi arm64-v8a && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/check-apk-release.ps1 -ApkPath android-app/app/build/outputs/apk/release/app-x86_64-release.apk -ExpectedAbi x86_64",
    "update:resources": "node tools/update-resources.mjs",
    "recognition:icons": "node tools/recognition/run-icon-match.mjs",
    "recognition:vision:build-dataset": "python tools/recognition/build-pokemon-vision-dataset.py",
    "recognition:vision:evaluate": "python tools/recognition/pokemon-vision-pipeline.py evaluate",
    "recognition:vision:evaluate:labeled": "python tools/recognition/pokemon-vision-pipeline.py evaluate --crop-mode team-preview-safe-zone --use-labeled-roi-templates --labeled-template-scope same-side --augment-count 1 --side-weights opponent:phash=0,edge=0.4,color=0.2,template=0.4 --labeled-template-bonus 0.04",
    "recognition:vision:tune": "python tools/recognition/pokemon-vision-pipeline.py tune-weights",
    "recognition:vision:cross-validate": "python tools/recognition/pokemon-vision-pipeline.py cross-validate",
    "recognition:vision:calibrate-roi": "python tools/recognition/pokemon-vision-pipeline.py calibrate-roi",
    "recognition:vision:predict": "python tools/recognition/pokemon-vision-pipeline.py predict",
    "recognition:vision:predict:labeled": "python tools/recognition/pokemon-vision-pipeline.py predict --crop-mode team-preview-safe-zone --use-labeled-roi-templates --labeled-template-labels dataset/labels.csv --labeled-template-images-dir dataset/real_train --labeled-template-scope same-side --augment-count 1 --side-weights opponent:phash=0,edge=0.4,color=0.2,template=0.4 --labeled-template-bonus 0.04",
    "recognition:vision:augment": "python tools/recognition/pokemon-vision-pipeline.py augment",
    "recognition:android:templates": "python tools/android/export-team-preview-templates.py --verify",
    "recognition:rapidocr-own-team": "node tools/recognition/extract-own-team-rapidocr.mjs"
  },
  "dependencies": {
    "sharp": "0.35.2"
  },
  "devDependencies": {
    "@pkmn/dex": "0.10.11",
    "@pkmn/mods": "0.10.11",
    "@types/node": "24.0.10",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
